{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MACAW",
  "identifier": "ai.macaw.desktop",
  "bundle": {
    "icon": [
      "icons/prod/32x32.png",
      "icons/prod/128x128.png",
      "icons/prod/128x128@2x.png",
      "icons/prod/icon.icns",
      "icons/prod/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "../../../script/sign-windows.ps1", "%1"]
      },
      "nsis": {
        "installerIcon": "icons/prod/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/ai.macaw.desktop.metainfo.xml": "release/appstream.metainfo.xml"
        }
      },
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    }
  }
}
